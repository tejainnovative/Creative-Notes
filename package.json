{
  "name": "creative-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "tokens": "node scripts/tokens.mjs",
    "contrast": "node scripts/contrast.mjs design/tokens.json",
    "api": "node server/src/dev.ts",
    "api:mock": "node server/src/dev.ts --mock",
    "typecheck:server": "node node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "test:server": "node --test \"server/test/*.test.ts\"",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --project=phone --project=desktop",
    "test": "npm run test:server && npm run test:e2e",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "test:whisper": "node node_modules/@playwright/test/cli.js test --project=whisper",
    "publish": "bash scripts/publish.sh",
    "deploy:api": "node scripts/build-worker.mjs && node node_modules/wrangler/bin/wrangler.js deploy dist-worker/worker.js --no-bundle"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@huggingface/transformers": "4.3.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "npm:esbuild-wasm@^0.28.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@0.28.2"
  }
}
