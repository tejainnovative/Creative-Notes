# Creative Notes server settings. Copy to .env.local for `npm run api`;
# in production set them as Cloudflare Worker secrets (`wrangler secret put NAME`).
# Never commit real values. .env* is git-ignored.

# Claude API key from console.anthropic.com (Settings -> API keys).
# Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Deepgram API key with Member permission (console.deepgram.com). Used only to mint
# one-minute browser tokens; it never reaches the browser.
DEEPGRAM_API_KEY=

# Typed once on each device to connect it. At least 16 characters; long and random is best:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_CODE=

# Encrypts Siri inbox notes at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INBOX_KEY=

# Optional. Defaults to claude-opus-5-5.
AI_MODEL=

# Optional. Input + output tokens per device per UTC day. Defaults to 2000000.
DAILY_TOKEN_BUDGET=
